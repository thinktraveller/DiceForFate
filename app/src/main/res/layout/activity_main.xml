<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Dice for Fate" android:textSize="20sp" android:textStyle="bold" />
  <Button android:id="@+id/btnHistory" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:text="历史" android:contentDescription="打开历史记录" />
  <Button android:id="@+id/btnSettings" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:text="设置" android:contentDescription="打开模式与字号设置" />
 </LinearLayout>
 <ScrollView android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="个数" android:textStyle="bold" android:layout_marginEnd="4dp" />
    <RadioGroup android:id="@+id/countOptions" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" />
    <Button android:id="@+id/btnCustomCount" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="自定义个数" />
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="面数" android:textStyle="bold" />
    <Button android:id="@+id/btnCustomSides" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="自定义面数" />
   </LinearLayout>
   <GridLayout android:id="@+id/sideOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4" android:rowCount="2" />
   <TextView android:id="@+id/tvSelection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
   <TextView android:id="@+id/tvModes" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:paddingBottom="8dp" />
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:strokeWidth="1dp" app:strokeColor="?attr/colorControlNormal" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
     <TextView android:id="@+id/tvResultDice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="上次结果" android:textSize="16sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
     <TextView android:id="@+id/tvEmptyResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择骰型，投掷你的第一个结果" android:paddingTop="20dp" android:paddingBottom="20dp" android:gravity="center" />
     <GridLayout android:id="@+id/resultGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" />
     <TextView android:id="@+id/tvSumLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:paddingTop="4dp" android:visibility="gone" android:textIsSelectable="true" />
     <TextView android:id="@+id/tvExcludedLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:visibility="gone" android:textIsSelectable="true" />
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
    <TextView android:id="@+id/tvRound" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/btnRoundDetails" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="查看已掷" />
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <Button android:id="@+id/btnRoll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:minHeight="56dp" android:text="投掷" android:textSize="18sp" />
</LinearLayout>
